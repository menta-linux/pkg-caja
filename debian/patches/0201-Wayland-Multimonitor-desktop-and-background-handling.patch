+    GSettingsSchema *schema;
+
+    schema = source != NULL ? g_settings_schema_source_lookup (source, MATE_BG_MONITOR_SCHEMA, TRUE) : NULL;
+    if (schema == NULL)
+        return NULL;
+    g_settings_schema_unref (schema);
+
+    hbox = gtk_box_new (GTK_ORIENTATION_HORIZONTAL, 5);
